<script type="module">
import{initializeApp}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import{getDatabase,ref,set,get,onValue,remove,update}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";
import{getAuth,createUserWithEmailAndPassword,signInWithEmailAndPassword,sendPasswordResetEmail,onAuthStateChanged,signOut}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

const FC={apiKey:"AIzaSyD-JWJD7w1h1YiRUD111vI-a5NL9-KyyCg",authDomain:"tip-odds.firebaseapp.com",databaseURL:"https://tip-odds-default-rtdb.asia-southeast1.firebasedatabase.app",projectId:"tip-odds",storageBucket:"tip-odds.firebasestorage.app",messagingSenderId:"1083219774857",appId:"1:1083219774857:web:097cdffae417a7ef4f2558"};
const app2=initializeApp(FC);
const db=getDatabase(app2);
const auth=getAuth(app2);
const r=p=>ref(db,p);
const dg=async p=>{const s=await get(r(p));return s.exists()?s.val():null};
const ds=async(p,v)=>set(r(p),v);
const du=async(p,v)=>update(r(p),v);
const dr=async p=>remove(r(p));
function dl(p,cb){return onValue(r(p),s=>cb(s.exists()?s.val():null),()=>{})}

let CU=null,AM={},AT={},AU={},AG={},AB={},lbMode='all',curRnd=null,curPage='land';

const calcP=o=>Math.round(100-(1/o)*100);
const impP=o=>Math.round((1/o)*100);
const isKO=m=>m.stage==='knockout';
const isLk=m=>m.result||(m.datetime&&new Date(m.datetime)<=new Date());
const tF=n=>{const f={'Brazil':'🇧🇷','Argentina':'🇦🇷','France':'🇫🇷','Germany':'🇩🇪','Spain':'🇪🇸','England':'🏴󠁧󠁢󠁥󠁮󠁧󠁿','Portugal':'🇵🇹','Italy':'🇮🇹','Netherlands':'🇳🇱','Belgium':'🇧🇪','Uruguay':'🇺🇾','Mexico':'🇲🇽','USA':'🇺🇸','Australia':'🇦🇺','Japan':'🇯🇵','Morocco':'🇲🇦','Senegal':'🇸🇳','Croatia':'🇭🇷','Denmark':'🇩🇰','Switzerland':'🇨🇭','South Korea':'🇰🇷','Ecuador':'🇪🇨','Canada':'🇨🇦','Colombia':'🇨🇴','Peru':'🇵🇪','Chile':'🇨🇱','Panama':'🇵🇦','Costa Rica':'🇨🇷','Saudi Arabia':'🇸🇦','Iran':'🇮🇷','Nigeria':'🇳🇬','Ghana':'🇬🇭','Cameroon':'🇨🇲','Egypt':'🇪🇬','Tunisia':'🇹🇳','Czech Republic':'🇨🇿','Austria':'🇦🇹','Poland':'🇵🇱','Serbia':'🇷🇸','Romania':'🇷🇴','Turkey':'🇹🇷','Ukraine':'🇺🇦','Slovakia':'🇸🇰','Slovenia':'🇸🇮','Greece':'🇬🇷','Scotland':'🏴󠁧󠁢󠁳󠁣󠁴󠁿','Wales':'🏴󠁧󠁢󠁷󠁬󠁳󠁿','Ireland':'🇮🇪','Norway':'🇳🇴','Sweden':'🇸🇪','New Zealand':'🇳🇿','Venezuela':'🇻🇪','Paraguay':'🇵🇾','Bolivia':'🇧🇴','Honduras':'🇭🇳','Jamaica':'🇯🇲','Qatar':'🇶🇦'};return f[n]||'⚽'};

function fmtL(dt){if(!dt)return'';return new Date(dt).toLocaleString('en-AU',{weekday:'short',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})}
function fmtV(dt,v){if(!dt||!v)return'';const vm={'new york':'America/New_York','new jersey':'America/New_York','east rutherford':'America/New_York','boston':'America/New_York','miami':'America/New_York','atlanta':'America/New_York','philadelphia':'America/New_York','dallas':'America/Chicago','houston':'America/Chicago','kansas city':'America/Chicago','chicago':'America/Chicago','los angeles':'America/Los_Angeles','san francisco':'America/Los_Angeles','seattle':'America/Los_Angeles','vancouver':'America/Vancouver','toronto':'America/Toronto','mexico city':'America/Mexico_City','guadalajara':'America/Mexico_City','monterrey':'America/Monterrey'};const tz=vm[v.toLowerCase()]||'America/New_York';try{return new Date(dt).toLocaleString('en-AU',{timeZone:tz,hour:'2-digit',minute:'2-digit',timeZoneName:'short'})+' ('+v+')';}catch{return''}}

let tt2;
window.toast2=function(msg,type='info'){const el=document.getElementById('toast');el.textContent=msg;el.className='show '+type;clearTimeout(tt2);tt2=setTimeout(()=>el.className='',3200)};
const toast=window.toast2;

let ccb=null;
window.closeC=function(){document.getElementById('cdlg').classList.remove('show');ccb=null};
document.getElementById('cok').onclick=()=>{closeC();if(ccb)ccb()};
function showC(t,m,cb,d=true){document.getElementById('ct').textContent=t;document.getElementById('cm').textContent=m;const b=document.getElementById('cok');b.className='btn '+(d?'bd':'bp');ccb=cb;document.getElementById('cdlg').classList.add('show')}

function showOv(){document.getElementById('ov').classList.add('show')}
function hideOv(){document.getElementById('ov').classList.remove('show')}

window.showPage=function(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  const el=document.getElementById('page-'+id);
  if(el)el.classList.add('active');
  curPage=id;
  document.querySelectorAll('.nb').forEach(b=>b.classList.remove('active'));
  const nb=document.getElementById('nv-'+id);
  if(nb)nb.classList.add('active');
  if(id==='tips')renderTips();
  if(id==='lb')renderLB();
  if(id==='grp')renderGrp();
  if(id==='bkt')renderBkt();
  if(id==='hist')renderHist(CU?.username);
  if(id==='adm')renderAdm();
  window.scrollTo(0,0);
};
window.goHome=function(){showPage(CU?'tips':'land')};

function setUser(u){
  CU=u;
  document.getElementById('nav').style.display='flex';
  document.getElementById('nv-adm').style.display=u.isAdmin?'':'none';
  const ini=u.name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  document.getElementById('ua').innerHTML=`<div class="uchip"><div class="uav">${ini}</div><span>${u.name}</span><button class="btn bg bsm" onclick="doOut()" style="padding:3px 9px;font-size:11px">Out</button></div>`;
  startL();showPage('tips');
}
window.doOut=async function(){await signOut(auth);CU=null;document.getElementById('nav').style.display='none';document.getElementById('ua').innerHTML='';showPage('land')};

window.doReg=async function(){
  const name=document.getElementById('rn').value.trim();
  const user=document.getElementById('ru').value.trim().toLowerCase();
  const email=document.getElementById('re').value.trim();
  const pass=document.getElementById('rp').value;
  const pass2=document.getElementById('rp2').value;
  if(!name||!user||!email||!pass){toast('Fill in all fields','err');return}
  if(pass!==pass2){toast('Passwords do not match','err');return}
  if(pass.length<6){toast('Password must be at least 6 characters','err');return}
  if(!/^[a-z0-9_]+$/.test(user)){toast('Username: letters, numbers, underscores only','err');return}
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){toast('Enter a valid email address','err');return}
  showOv();
  const ex=await dg('users/'+user);
  if(ex){hideOv();toast('Username taken — choose another','err');return}
  // Check email not already used
  const emailKey=email.replace(/[.#$\[\]]/g,'_');
  const exEmail=await dg('emails/'+emailKey);
  if(exEmail){hideOv();toast('Email already registered — sign in instead','err');return}
  try{
    const cred=await createUserWithEmailAndPassword(auth,email,pass);
    const isAdmin=user==='admin';
    await ds('users/'+user,{name,username:user,email,uid:cred.user.uid,isAdmin,joined:new Date().toISOString()});
    await ds('emails/'+emailKey,{username:user});
    await ds('uids/'+cred.user.uid,{username:user});
    hideOv();toast('Account created!','ok');
    setUser({name,username:user,isAdmin});
  }catch(e){
    hideOv();
    if(e.code==='auth/email-already-in-use')toast('Email already registered — sign in instead','err');
    else toast('Error: '+e.message,'err');
  }
};

window.doLogin=async function(){
  const email=document.getElementById('le').value.trim();
  const pass=document.getElementById('lp').value;
  if(!email||!pass){toast('Fill in all fields','err');return}
  showOv();
  try{
    const cred=await signInWithEmailAndPassword(auth,email,pass);
    const userData=await dg('uids/'+cred.user.uid);
    if(!userData){hideOv();toast('Account not found — please register','err');return}
    const u=await dg('users/'+userData.username);
    hideOv();
    if(!u){toast('User data not found','err');return}
    toast('Welcome back, '+u.name+'!','ok');
    setUser({name:u.name,username:userData.username,isAdmin:u.isAdmin});
  }catch(e){
    hideOv();
    if(e.code==='auth/invalid-credential'||e.code==='auth/wrong-password'||e.code==='auth/user-not-found')
      toast('Wrong email or password','err');
    else toast('Sign in error: '+e.message,'err');
  }
};

window.doForgot=async function(){
  const email=document.getElementById('fe').value.trim();
  if(!email){toast('Enter your email address','err');return}
  showOv();
  try{
    await sendPasswordResetEmail(auth,email);
    hideOv();
    toast('Reset email sent! Check your inbox.','ok');
    showPage('login');
  }catch(e){
    hideOv();
    if(e.code==='auth/user-not-found')toast('No account found with that email','err');
    else toast('Error: '+e.message,'err');
  }
};

function startL(){
  dl('matches',v=>{AM=v||{};if(['tips','lb','hist','adm'].includes(curPage))refreshP()});
  dl('tips',v=>{AT=v||{};if(['tips','lb','hist'].includes(curPage))refreshP()});
  dl('users',v=>{AU=v||{};if(['lb','adm'].includes(curPage))refreshP()});
  dl('groups',v=>{AG=v||{};if(curPage==='grp')renderGrp()});
  dl('bracket',v=>{AB=v||{};if(curPage==='bkt')renderBkt()});
  dl('.info/connected',v=>{if(v)hideOv()});
}
function refreshP(){if(curPage==='tips')renderTips();if(curPage==='lb')renderLB();if(curPage==='hist')renderHist(CU?.username);if(curPage==='adm')renderAdm()}

function renderTips(){
  if(!CU)return;
  const mt=AT[CU.username]||{};
  const ms=Object.values(AM).sort((a,b)=>new Date(a.datetime)-new Date(b.datetime));
  let pts=0,made=0,corr=0,best=0;
  ms.forEach(m=>{const t=mt[m.id];if(t){made++;if(m.result&&t.pick===m.result){pts+=t.pts;corr++;if(t.pts>best)best=t.pts}}});
  document.getElementById('s-pts').textContent=pts;
  document.getElementById('s-nt').textContent=made;
  document.getElementById('s-co').textContent=corr;
  document.getElementById('s-bw').textContent=best>0?best:'—';
  const rnds=[...new Set(ms.map(m=>m.round||'General'))];
  const tabs=document.getElementById('ttabs');tabs.innerHTML='';
  if(rnds.length>1){
    if(!curRnd||!rnds.includes(curRnd))curRnd=rnds[0];
    rnds.forEach(rv=>{const b=document.createElement('button');b.className='tp'+(curRnd===rv?' active':'');b.textContent=rv;b.onclick=()=>{curRnd=rv;renderTips()};tabs.appendChild(b)});
  }else curRnd=rnds[0]||null;
  const vis=rnds.length>1?ms.filter(m=>(m.round||'General')===curRnd):ms;
  const el=document.getElementById('tlist');
  if(!vis.length){el.innerHTML='<div class="emp"><div class="ei">🕐</div><p>No matches yet.<br>Check back soon!</p></div>';return}
  el.innerHTML=vis.map(m=>mCard(m,mt[m.id])).join('');
}

function mCard(m,myTip){
  const lk=isLk(m),ko=isKO(m);
  const rm={H:'Home Win',D:'Draw',A:'Away Win'};
  const allTC=Object.values(AT).filter(p=>p[m.id]);
  const tc=allTC.length;
  const pH=calcP(+m.oddsH),pD=!ko?calcP(+m.oddsD):null,pA=calcP(+m.oddsA);
  const pc=pick=>{let c='op';if(myTip?.pick===pick)c+=' '+(pick==='H'?'sh':pick==='D'?'sd':'sa');if(lk)c+=' lk';return c};
  let trevealed='';
  if(lk&&tc>0){
    const hc=allTC.filter(p=>p[m.id]?.pick==='H').length;
    const dc=!ko?allTC.filter(p=>p[m.id]?.pick==='D').length:0;
    const ac=allTC.filter(p=>p[m.id]?.pick==='A').length;
    trevealed=`<div class="tcre"><span>🏠 ${hc}</span>${!ko?`<span>🤝 ${dc}</span>`:''}<span>✈ ${ac}</span><span style="margin-left:auto">${tc}/${Object.keys(AU).length} tipped</span></div>`;
  }else if(!lk&&tc>0){
    trevealed=`<div class="tcr">👥 ${tc} player${tc!==1?'s':''} have tipped this match</div>`;
  }
  let banner='';
  if(m.result&&myTip){const won=myTip.pick===m.result;banner=won?`<div class="tbn won">✅ Correct! +${myTip.pts} pts — ${rm[m.result]}</div>`:`<div class="tbn lost">❌ Wrong — Result: ${rm[m.result]}</div>`}
  else if(m.result&&!myTip){banner=`<div class="tbn none">⏱ No tip placed — Result: ${rm[m.result]}</div>`}
  else if(myTip&&!m.result){banner=`<div class="tbn pend">✓ Tip locked: ${rm[myTip.pick]}</div>`}
  return`<div class="mc">
    <div class="mh">
      <span class="mbdg">${m.round||'General'}${ko?' · KO':''}</span>
      <div class="mtb"><span class="mtl">${fmtL(m.datetime)}</span>${m.venue?`<span class="mtv">${fmtV(m.datetime,m.venue)}</span>`:''}</div>
      ${lk?'<span style="color:var(--muted2);font-size:10px">🔒</span>':''}
    </div>
    <div class="mb">
      <div class="tm"><div class="tf">${tF(m.home)}</div><div class="tn">${m.home}</div>${m.homePH?`<div class="tsub">${m.homePH}</div>`:''}</div>
      <div class="vc">${m.result?`<div class="vs">${m.scoreH??'?'} – ${m.scoreA??'?'}</div>`:`<div class="vt">VS</div>`}</div>
      <div class="tm"><div class="tf">${tF(m.away)}</div><div class="tn">${m.away}</div>${m.awayPH?`<div class="tsub">${m.awayPH}</div>`:''}</div>
    </div>
    <div class="or">
      <div class="${pc('H')}" onclick="pTip('${m.id}','H')"><div class="ol">Home</div><div class="ov2">${impP(+m.oddsH)}%</div><div class="op2">${pH} pts</div></div>
      ${!ko?`<div class="${pc('D')}" onclick="pTip('${m.id}','D')"><div class="ol">Draw</div><div class="ov2">${impP(+m.oddsD)}%</div><div class="op2">${pD} pts</div></div>`:''}
      <div class="${pc('A')}" onclick="pTip('${m.id}','A')"><div class="ol">Away</div><div class="ov2">${impP(+m.oddsA)}%</div><div class="op2">${pA} pts</div></div>
    </div>
    ${trevealed}${banner}
  </div>`;
}

window.pTip=async function(mid,pick){
  if(!CU)return;const m=AM[mid];if(!m||isLk(m))return;
  showOv();
  const odds=pick==='H'?+m.oddsH:pick==='D'?+m.oddsD:+m.oddsA;
  const pts=calcP(odds);
  await ds(`tips/${CU.username}/${mid}`,{pick,pts,ts:Date.now()});
  hideOv();
  const rm={H:'Home Win',D:'Draw',A:'Away Win'};
  toast('Tip: '+rm[pick]+' · '+pts+' pts if correct','ok');
};

function renderLB(){
  const ms=Object.values(AM),us=Object.values(AU);
  document.getElementById('lb-pl').textContent=us.length;
  document.getElementById('lb-dn').textContent=ms.filter(m=>m.result).length;
  const sf=lbMode==='group'?'group':lbMode==='knockout'?'knockout':null;
  function uStat(un){
    const mt=AT[un]||{};let pts=0,made=0,corr=0,best=0;
    ms.forEach(m=>{if(sf&&m.stage!==sf)return;const t=mt[m.id];if(t){made++;if(m.result&&t.pick===m.result){pts+=t.pts;corr++;if(t.pts>best)best=t.pts}}});
    return{pts,made,corr,best,pct:made>0?Math.round(corr/made*100):0};
  }
  let topU=0;
  Object.values(AT).forEach(pt=>ms.forEach(m=>{if(m.result&&pt[m.id]?.pick===m.result&&pt[m.id].pts>topU)topU=pt[m.id].pts}));
  document.getElementById('lb-up').textContent=topU>0?topU:'—';
  const rows=us.map(u=>({...uStat(u.username),name:u.name,un:u.username})).sort((a,b)=>b.pts-a.pts);
  const rc=['r1','r2','r3'];
  document.getElementById('lb-body').innerHTML=rows.map((p,i)=>`
    <tr class="${p.un===CU?.username?'me':''}" onclick="viewH('${p.un}')">
      <td><span class="rk ${rc[i]||''}">${i+1}</span></td>
      <td><div style="font-weight:500">${p.name}${p.un===CU?.username?' <span style="color:var(--accent);font-size:10px">(you)</span>':''}</div><div style="font-size:11px;color:var(--muted)">${p.corr}/${p.made} correct</div></td>
      <td>${p.made}</td><td>${p.pct}%</td>
      <td style="font-family:'DM Mono',monospace;font-size:12px;color:var(--muted)">${p.best>0?p.best+' pts':'—'}</td>
      <td><span class="pbig">${p.pts}</span></td>
    </tr>`).join('')||'<tr><td colspan="6"><div class="emp"><div class="ei">🏆</div><p>No players yet</p></div></td></tr>';
}
window.lbT=function(m,btn){lbMode=m;document.querySelectorAll('#page-lb .tp').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderLB()};
window.viewH=function(un){renderHist(un);showPage('hist')};

function renderHist(un){
  if(!un)return;
  const u=AU[un],mt=AT[un]||{};
  const ms=Object.values(AM).sort((a,b)=>new Date(b.datetime)-new Date(a.datetime));
  const rm={H:'Home Win',D:'Draw',A:'Away Win'};
  let pts=0,made=0,corr=0,best=0;
  ms.forEach(m=>{const t=mt[m.id];if(t){made++;if(m.result&&t.pick===m.result){pts+=t.pts;corr++;if(t.pts>best)best=t.pts}}});
  const isMe=un===CU?.username;
  document.getElementById('hist-title').innerHTML=isMe?'My <span>History</span>':(u?.name||un)+"'s <span>History</span>";
  document.getElementById('hist-stats').innerHTML=`
    <div class="sbox"><div class="slbl">Points</div><div class="sval">${pts}</div></div>
    <div class="sbox"><div class="slbl">Correct %</div><div class="sval">${made>0?Math.round(corr/made*100):0}%</div></div>
    <div class="sbox"><div class="slbl">Best Upset</div><div class="sval">${best>0?best:'—'}</div></div>`;
  const el=document.getElementById('hist-list');
  if(!ms.length){el.innerHTML='<div class="emp"><div class="ei">📋</div><p>No matches yet</p></div>';return}
  el.innerHTML=ms.map(m=>{
    const t=mt[m.id];
    let cls='pend',lbl='—',bdg='';
    if(!t){bdg=`<span class="bdg bgr">No tip</span>`;lbl='0 pts';cls='lost'}
    else if(!m.result){bdg=`<span class="bdg bgb">${rm[t.pick]}</span>`;lbl='Pending';cls='pend'}
    else if(t.pick===m.result){bdg=`<span class="bdg bg2">✓ ${rm[t.pick]}</span>`;lbl='+'+t.pts+' pts';cls='won'}
    else{bdg=`<span class="bdg bgred">✗ ${rm[t.pick]}</span>`;lbl='0 pts';cls='lost'}
    return`<div class="hi"><div><div class="hm">${m.home} vs ${m.away}</div><div class="hs">${m.round||''} · ${fmtL(m.datetime)}</div></div><div style="text-align:right">${bdg}<div class="hpts ${cls}" style="margin-top:3px">${lbl}</div></div></div>`;
  }).join('');
}

function renderGrp(){
  const el=document.getElementById('ggrid');
  if(!AG||!Object.keys(AG).length){el.innerHTML='<div class="emp"><div class="ei">🗓</div><p>Group standings will appear once matches begin.</p></div>';return}
  el.innerHTML=Object.entries(AG).sort((a,b)=>a[0].localeCompare(b[0])).map(([gn,gd])=>{
    const ts=gd.teams?Object.values(gd.teams).sort((a,b)=>b.pts-a.pts||b.gd-a.gd||b.gf-a.gf):[];
    return`<div class="gc"><div class="gh">Group <span>${gn.replace('group','')}</span></div>
      <table class="gt"><thead><tr><th>Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GD</th><th>Pts</th></tr></thead>
      <tbody>${ts.map((t,i)=>`<tr class="${i<2?'q':''}"><td><span style="font-size:14px;margin-right:5px">${tF(t.name)}</span>${t.name}</td><td>${t.p||0}</td><td>${t.w||0}</td><td>${t.d||0}</td><td>${t.l||0}</td><td>${(t.gd||0)>0?'+':''}${t.gd||0}</td><td><strong>${t.pts||0}</strong></td></tr>`).join('')}</tbody></table>
      <div class="gn">🟢 Top 2 qualify · Best 3rd-placed also advance</div></div>`;
  }).join('');
}

function renderBkt(){
  const el=document.getElementById('bkt-inner');
  const rnds=['Round of 32','Round of 16','Quarter-final','Semi-final','Final'];
  const ms=Object.values(AM).filter(m=>m.stage==='knockout');
  if(!ms.length){el.innerHTML='<div class="emp"><div class="ei">🏆</div><p>Bracket appears when knockout stage begins.</p></div>';return}
  el.innerHTML=rnds.map(rn=>{
    const rm=ms.filter(m=>m.round===rn);if(!rm.length)return'';
    return`<div class="brd"><div class="brt">${rn}</div><div class="brm">${rm.map(m=>`
      <div class="bm">
        <div class="bt ${m.result==='H'?'win':''}"><span style="font-size:13px;margin-right:3px">${tF(m.home)}</span><span class="btn2">${m.home}${m.homePH?' <small style="color:var(--muted2)">('+m.homePH+')</small>':''}</span><span class="bsc">${m.scoreH??''}</span></div>
        <div class="bt ${m.result==='A'?'win':''}"><span style="font-size:13px;margin-right:3px">${tF(m.away)}</span><span class="btn2">${m.away}${m.awayPH?' <small style="color:var(--muted2)">('+m.awayPH+')</small>':''}</span><span class="bsc">${m.scoreA??''}</span></div>
      </div>`).join('')}</div></div>`;
  }).filter(Boolean).join('');
}

// ── ADMIN ──────────────────────────────────────
window.aTab=function(t,btn){
  ['add','res','grps','plyr'].forEach(x=>document.getElementById('at-'+x).style.display=x===t?'':'none');
  document.querySelectorAll('#page-adm .tp').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  if(t==='res')renderResTab();if(t==='grps')renderGrpsAdmin();if(t==='plyr')renderPlyrTab();
};

document.getElementById('ast').onchange=function(){document.getElementById('adf').style.display=this.value==='knockout'?'none':''};

window.addMatch=async function(){
  if(!CU?.isAdmin)return;
  const home=document.getElementById('ah').value.trim();
  const away=document.getElementById('aa').value.trim();
  const dt=document.getElementById('adt').value;
  const vc=document.getElementById('avc').value.trim();
  const rd=document.getElementById('ard').value.trim();
  const st=document.getElementById('ast').value;
  const oh=parseFloat(document.getElementById('aoh').value);
  const od=st==='knockout'?1:parseFloat(document.getElementById('aod').value);
  const oa=parseFloat(document.getElementById('aoa').value);
  if(!home||!away||!dt||isNaN(oh)||isNaN(oa)||(st!=='knockout'&&isNaN(od))){toast('Fill all required fields','err');return}
  if(oh<1.01||oa<1.01||(st!=='knockout'&&od<1.01)){toast('Odds must be above 1.0','err');return}
  const ex=Object.values(AM).find(m=>m.home===home&&m.away===away&&Math.abs(new Date(m.datetime)-new Date(dt))<86400000);
  if(ex){showC('Duplicate Match?',`${home} vs ${away} already exists around that date. Add anyway?`,()=>doAdd(home,away,dt,vc,rd,st,oh,od,oa),false);return}
  await doAdd(home,away,dt,vc,rd,st,oh,od,oa);
};
async function doAdd(home,away,dt,vc,rd,st,oh,od,oa){
  const id='m'+Date.now();
  await ds('matches/'+id,{id,home,away,datetime:dt,venue:vc,round:rd,stage:st,oddsH:oh,oddsD:od,oddsA:oa,result:null,scoreH:null,scoreA:null,created:Date.now()});
  ['ah','aa','adt','avc','ard','aoh','aod','aoa'].forEach(f=>{const el=document.getElementById(f);if(el)el.value=''});
  toast(home+' vs '+away+' added!','ok');
}

function renderAdm(){renderUpcoming();renderResTab()}
function renderUpcoming(){
  const up=Object.values(AM).filter(m=>!m.result).sort((a,b)=>new Date(a.datetime)-new Date(b.datetime));
  const el=document.getElementById('a-upcoming');
  if(!up.length){el.innerHTML='<div class="emp"><div class="ei">📋</div><p>No upcoming matches</p></div>';return}
  el.innerHTML=up.map(m=>`<div class="amr">
    <div class="amt">${tF(m.home)} ${m.home} vs ${m.away} ${tF(m.away)}</div>
    <div class="amm">${m.round||''} · ${fmtL(m.datetime)}${m.venue?' · '+m.venue:''}</div>
    <div class="aod">H: <span>${(+m.oddsH).toFixed(2)}</span> · D: <span>${(+m.oddsD).toFixed(2)}</span> · A: <span>${(+m.oddsA).toFixed(2)}</span></div>
    <div style="display:flex;gap:7px;flex-wrap:wrap">
      <button class="btn bg bsm" onclick="editTeams('${m.id}')">✏ Update Teams</button>
      <button class="btn bd bsm" onclick="delMatch('${m.id}')">🗑 Delete</button>
    </div>
  </div>`).join('');
}
function renderResTab(){
  const pend=Object.values(AM).filter(m=>!m.result&&isLk(m)).sort((a,b)=>new Date(a.datetime)-new Date(b.datetime));
  const done=Object.values(AM).filter(m=>m.result).sort((a,b)=>new Date(b.datetime)-new Date(a.datetime));
  const el=document.getElementById('a-reslist');
  const rm={H:'Home Win',D:'Draw',A:'Away Win'};
  let html='';
  if(pend.length){html+=`<div class="slabel" style="margin-bottom:10px">Awaiting Result</div>`;html+=pend.map(m=>`<div class="amr"><div class="amt">${tF(m.home)} ${m.home} vs ${m.away} ${tF(m.away)}</div><div class="amm">${m.round||''} · ${fmtL(m.datetime)}</div>
    <div class="rbs"><button class="rb rh ${m.result==='H'?'ac':''}" onclick="setRes('${m.id}','H')">🏠 Home Win</button>${!isKO(m)?`<button class="rb rd ${m.result==='D'?'ac':''}" onclick="setRes('${m.id}','D')">🤝 Draw</button>`:''}<button class="rb ra ${m.result==='A'?'ac':''}" onclick="setRes('${m.id}','A')">✈ Away Win</button></div>
  </div>`).join('')}
  if(done.length){html+=`<div class="slabel" style="margin:18px 0 10px">Completed</div>`;html+=done.map(m=>`<div class="amr"><div class="amt">${tF(m.home)} ${m.home} vs ${m.away} ${tF(m.away)} <span class="bdg bg2" style="margin-left:6px">${rm[m.result]}</span></div><div class="amm">${m.round||''} · ${fmtL(m.datetime)}</div><button class="btn bg bsm" onclick="fixRes('${m.id}')">✏ Correct Result</button></div>`).join('')}
  if(!pend.length&&!done.length)html='<div class="emp"><div class="ei">⏳</div><p>No locked matches yet</p></div>';
  el.innerHTML=html;
}
window.setRes=function(mid,result){
  const m=AM[mid];if(!m)return;
  const rm={H:'Home Win',D:'Draw',A:'Away Win'};
  showC('Confirm Result',`${m.home} vs ${m.away}: ${rm[result]}. Points awarded to all correct tips.`,async()=>{
    await du('matches/'+mid,{result});toast('Result saved — points updated','ok');renderResTab();
  });
};
window.fixRes=function(mid){
  const m=AM[mid];if(!m)return;
  const rm={H:'Home Win',D:'Draw',A:'Away Win'};
  showC('Correct Result?',`Clear result for ${m.home} vs ${m.away} (currently: ${rm[m.result]})? Points will recalculate once you re-enter the correct result.`,async()=>{
    await du('matches/'+mid,{result:null});toast('Result cleared — re-enter in Awaiting Results','info');renderResTab();
  });
};
window.editTeams=function(mid){
  const m=AM[mid];if(!m)return;
  const nh=prompt('Home team:',m.home);if(!nh)return;
  const na=prompt('Away team:',m.away);if(!na)return;
  const ph=prompt('Home placeholder (e.g. "Winner Group A"), or blank:',m.homePH||'');
  const pa=prompt('Away placeholder (e.g. "Runner-up Group B"), or blank:',m.awayPH||'');
  du('matches/'+mid,{home:nh,away:na,homePH:ph||null,awayPH:pa||null});toast('Teams updated','ok');
};
window.delMatch=function(mid){
  const m=AM[mid];if(!m)return;
  showC('Delete Match?',`Remove ${m.home} vs ${m.away}? All tips for this match will be deleted.`,async()=>{
    await dr('matches/'+mid);
    const upd={};Object.keys(AU).forEach(u=>{upd[`tips/${u}/${mid}`]=null});
    if(Object.keys(upd).length)await update(ref(db,'/'),upd);
    toast('Match deleted','ok');
  });
};
function renderGrpsAdmin(){
  const el=document.getElementById('a-grpform');
  const teams=[...new Set(Object.values(AM).filter(m=>m.stage==='group').flatMap(m=>[m.home,m.away]))];
  const gls=['A','B','C','D','E','F','G','H','I','J','K','L'];
  el.innerHTML=`<div class="ibox" style="margin-bottom:14px">Update standings after each matchday. Teams auto-populate from your group stage fixtures.</div>
  <div class="fr" style="margin-bottom:12px">
    <div class="fld"><label>Group</label><select id="gag">${gls.map(g=>`<option value="group${g}">Group ${g}</option>`).join('')}</select></div>
    <div class="fld"><label>Team</label><select id="gat"><option value="">Select team…</option>${teams.map(t=>`<option value="${t}">${tF(t)} ${t}</option>`).join('')}</select></div>
  </div>
  <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:14px">
    ${['P','W','D','L','GF','GA'].map(f=>`<div class="fld"><label>${f}</label><input type="number" id="gf${f.toLowerCase()}" min="0" value="0" inputmode="numeric"></div>`).join('')}
  </div>
  <button class="btn bp" onclick="saveGRow()">Update Standing →</button>`;
}
window.saveGRow=async function(){
  const grp=document.getElementById('gag').value;
  const team=document.getElementById('gat').value;
  if(!team){toast('Select a team','err');return}
  const p=+document.getElementById('gfp').value,w=+document.getElementById('gfw').value,d=+document.getElementById('gfd').value,l=+document.getElementById('gfl').value,gf=+document.getElementById('gfgf').value,ga=+document.getElementById('gfga').value;
  const gd=gf-ga,pts=w*3+d;
  await ds(`groups/${grp}/teams/${team.replace(/[^a-z0-9]/gi,'_')}`,{name:team,p,w,d,l,gf,ga,gd,pts});
  toast(team+' updated','ok');
};
window.adminResetPw=async function(email){
  showC('Reset Password?','Send a password reset email to '+email+'?',async()=>{
    try{await sendPasswordResetEmail(auth,email);toast('Reset email sent to '+email,'ok');}
    catch(e){toast('Error: '+e.message,'err');}
  },false);
};

function renderPlyrTab(){
  const el=document.getElementById('a-plyrlist');
  const us=Object.values(AU);
  if(!us.length){el.innerHTML='<div class="emp"><div class="ei">👥</div><p>No players yet</p></div>';return}
  el.innerHTML=us.map(u=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);flex-wrap:wrap;gap:6px">
    <div><span style="font-weight:500">${u.name}</span><span style="color:var(--muted);font-size:11px;margin-left:7px">@${u.username}</span>${u.isAdmin?'<span class="bdg bgo" style="margin-left:6px">Admin</span>':''}<div style="font-size:11px;color:var(--muted2);margin-top:2px">${u.email||'no email'}</div></div>
    <div style="display:flex;align-items:center;gap:8px"><span style="color:var(--muted);font-size:11px">${Object.keys(AT[u.username]||{}).length} tips</span>${u.email?`<button class="btn bg bsm" onclick="adminResetPw('${u.email}')">Reset PW</button>`:''}</div>
  </div>`).join('');
}

// Firebase Auth state — auto-restores session on page reload
onAuthStateChanged(auth,async fbUser=>{
  if(fbUser&&!CU){
    const userData=await dg('uids/'+fbUser.uid);
    if(userData){
      const u=await dg('users/'+userData.username);
      if(u){setUser({name:u.name,username:userData.username,isAdmin:u.isAdmin});}
    }
  } else if(!fbUser&&curPage!=='land'&&curPage!=='reg'&&curPage!=='login'&&curPage!=='forgot'){
    showPage('land');
  }
});

document.addEventListener('keydown',e=>{
  if(e.key==='Enter'){if(curPage==='login')doLogin();if(curPage==='reg')doReg();if(curPage==='forgot')doForgot()}
});
</script>
